extends _partial/layout.jade

block container
  header.site-intro
    p.site-kicker TECHNOLOGY · WORK · THINKING
    h1= config.title
    p.site-description= theme.description
    .intro-rule
      span= site.posts.length + ' 篇记录'
  include mixins/post
  +posts()

block pagination
  include mixins/paginator
  +index()

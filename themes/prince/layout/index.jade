extends _partial/layout.jade

block container
  - var homeImages = theme.homeImages || []
  if homeImages.length
    figure.home-hero
      img#home-hero-image.home-hero-image(src=homeImages[0] alt=config.title data-images=JSON.stringify(homeImages))
      header.site-intro
        p.site-kicker TECHNOLOGY · WORK · THINKING
        h1= config.title
        p.site-description= theme.description
        .intro-rule
          span= site.posts.length + ' 篇记录'
  else
    header.site-intro
      p.site-kicker TECHNOLOGY · WORK · THINKING
      h1= config.title
      p.site-description= theme.description
      .intro-rule
        span= site.posts.length + ' 篇记录'
  include mixins/post
  +posts()

block pagination
  include mixins/paginator
  +index()

mixin postInfo(page)
  time.post-info(datetime=date_xml(page.date))= date(page.date, 'YYYY.MM.DD')

mixin postPhotos(page)
  if page.photos && page.photos.length
    .post-gallery
      each photo in page.photos
        p
          img(src=url_for(photo))


mixin posts()
  .articles
    - page.posts.each(function(item){
      article.post-block
        +postPhotos(item)
        header.post-header
          +postInfo(item)
          h2.post-title
            -var title = item.title || item.slug || __('no title')
            if item.link
              a.post-link(href=url_for(item.link) target='_blank' rel='noopener')=title
            else
              a.post-link(href=url_for(item.path))=title
        .post-summary
          if item.excerpt
            != item.excerpt
          else
            - var summary = strip_html(item.content).replace(/\s+/g, ' ').trim()
            p= summary.length > 180 ? summary.substring(0, 180) + '…' : summary
        footer.post-meta
          a.article-more(href=url_for(item.path))
            span= theme.excerpt_link
            i.fa.fa-long-arrow-right(aria-hidden='true')
          if (item.tags && item.tags.length > 0)
            .post-tags-box!= list_tags(item.tags,{show_count:false,style:null,separator:''})
    - })

mixin post(page)
  .post
    article.post-block
      +postPhotos(page)
      -var title = page.title || page.slug || __('no title')
      header.article-header
        +postInfo(page)
        h1.post-title!= title
        if (page.tags && page.tags.length > 0)
          .post-tags-box!= list_tags(page.tags,{show_count:false,style:null,separator:''})
      .post-entry
        != page.content
  !=toc(page.content, {list_number:false})

mixin postTagList()
  .archive.col-md-8.col-xs-12
    - var posts = site.posts.sort('date',-1)
    - posts.each(function(item){
      -item.tags.each(function(tag){
        if page.tag == tag.name
          .post-item
            -var title = item.title || item.slug || __('no title')
            if item.link
              a.post-item-link(href=url_for(item.link) target='_blank')
                span.post-title.col-sm-9.col-xs-12=title
                span.post-date.col-sm-3.col-xs-12=full_date(item.date,'MMM Do YYYY')
              .postList-tags-box!= list_tags(item.tags,{show_count:false,style:null,saperator:','})
            else
              a.post-item-link(href=url_for(item.path))
                span.post-title.col-sm-9.col-xs-12=title
                span.post-date.col-sm-3.col-xs-12=full_date(item.date,'MMM Do YYYY')
              .postList-tags-box!= list_tags(item.tags,{show_count:false,style:null,saperator:','})
      -})
    -})


mixin postList()
  .archive
    - var posts = site.posts.sort('date',-1)
    - posts.each(function(item){
      .post-item
        -var title = item.title || item.slug || __('no title')
        if item.link
          a.post-item-link(href=url_for(item.link) target='_blank' rel='noopener')
            time.post-date(datetime=date_xml(item.date))=date(item.date,'YYYY.MM.DD')
            span.post-title=title
            i.fa.fa-arrow-right(aria-hidden='true')
        else
          a.post-item-link(href=url_for(item.path))
            time.post-date(datetime=date_xml(item.date))=date(item.date,'YYYY.MM.DD')
            span.post-title=title
            i.fa.fa-arrow-right(aria-hidden='true')
    -})

mixin index()
  - var prev = page.prev_link
  - var next = page.next_link
  .paginator
    if page.prev
      .prev-wrap
        i.fa.fa-long-arrow-left
        a.prev-page(href=url_for(page.prev_link))!= __('Previous')
    if page.next
      .next-wrap
        a.next-page(href=url_for(page.next_link))!= __('Next')
        i.fa.fa-long-arrow-right
mixin post()
  -var prev = page.prev ? page.prev.path : false;
  -var next = page.next ? page.next.path : false;
  .post-nav
    if prev
      -var title = page.prev.title || page.prev.slug || "（无标题）"
      .prev-wrap
        i.fa.fa-long-arrow-left
        a.prev-post(href=url_for(prev))
          small 上一篇
          span!= title
    if next
      -var title = page.next.title || page.next.slug || "（无标题）"
      .next-wrap
        a.next-post(href=url_for(next))
          small 下一篇
          span!= title
        i.fa.fa-long-arrow-right

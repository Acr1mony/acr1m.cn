nav.page-navigation
  .nav-container
    .page-header-logo
      a.home-link(href=url_for('/'))
        span.brand-mark= theme.name
        span.brand-description= theme.description
    button.navbar-toggle(type="button" aria-label="打开导航" aria-expanded="false")
      span.icon-bar
      span.icon-bar
      span.icon-bar
    ul.main-nav-items
      each value, key in theme.nav
        li.menu-item
          a(href=url_for(value) target='_self')=key
